'use client';

import React, { useState } from 'react';
import Link from 'next/link';
import { useParams } from 'next/navigation';
import { useIdea, useUpvoteIdea, useForkIdea } from '@/hooks/useIdeas';
import { CommentList } from '@/components/ui/CommentList';
import { FamilyTreePreview } from '@/components/ui/FamilyTreePreview';
import { FileSystemTab } from '@/components/ui/FileSystemTab';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Alert, AlertDescription } from '@/components/ui/alert';
import { useAuth } from '@/hooks/useAuth';
import { toast } from '@/hooks/use-toast';
import { 
  MessageSquare, 
  GitBranch, 
  FolderOpen, 
  FileText,
  Crown,
  Users,
  Settings,
  Shield,
  Calendar,
  User,
  Award,
  ExternalLink,
  Star,
  GitFork,
  Copy,
  FileCheck,
  Clock,
  Vote,
  Eye,
  Globe,
  Lock
} from 'lucide-react';
import { OwnershipType, AdoptionStatus } from '@shared/types/idea';

// Ownership Badge Component
const OwnershipBadge = ({ ownershipType }: { ownershipType: OwnershipType }) => {
  const config = {
    [OwnershipType.PERSONAL]: { 
      icon: User, 
      label: 'Personal', 
      className: 'bg-blue-100 text-blue-800 border-blue-200' 
    },
    [OwnershipType.OPEN_SOURCE]: { 
      icon: Globe, 
      label: 'Open Source', 
      className: 'bg-green-100 text-green-800 border-green-200' 
    },
    [OwnershipType.COLLABORATIVE]: { 
      icon: Users, 
      label: 'Collaborative', 
      className: 'bg-purple-100 text-purple-800 border-purple-200' 
    },
    [OwnershipType.ORGANIZATION]: { 
      icon: Shield, 
      label: 'Organization', 
      className: 'bg-orange-100 text-orange-800 border-orange-200' 
    },
    [OwnershipType.STEWARDSHIP]: { 
      icon: Crown, 
      label: 'Stewardship', 
      className: 'bg-yellow-100 text-yellow-800 border-yellow-200' 
    }
  };

  const { icon: Icon, label, className } = config[ownershipType];

  return (
    <Badge variant="outline" className={`${className} flex items-center gap-1`}>
      <Icon className="h-3 w-3" />
      {label}
    </Badge>
  );
};

// Adoption Status Badge Component
const AdoptionStatusBadge = ({ status }: { status: AdoptionStatus }) => {
  const config = {
    [AdoptionStatus.AVAILABLE]: { 
      label: 'Available for Adoption', 
      className: 'bg-green-100 text-green-800 border-green-200' 
    },
    [AdoptionStatus.PENDING]: { 
      label: 'Adoption Pending', 
      className: 'bg-yellow-100 text-yellow-800 border-yellow-200' 
    },
    [AdoptionStatus.IN_DISPUTE]: { 
      label: 'In Dispute', 
      className: 'bg-red-100 text-red-800 border-red-200' 
    },
    [AdoptionStatus.ADOPTED]: { 
      label: 'Adopted', 
      className: 'bg-blue-100 text-blue-800 border-blue-200' 
    }
  };

  const { label, className } = config[status];

  return (
    <Badge variant="outline" className={className}>
      {label}
    </Badge>
  );
};

// Adoption Request Component
const AdoptionRequestForm = ({ ideaId, currentUser }: { ideaId: string; currentUser: any }) => {
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [reason, setReason] = useState('');

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setIsSubmitting(true);
    
    try {
      // TODO: Implement adoption request API call
      toast({
        title: 'Adoption Request Submitted',
        description: 'Your request has been submitted for review.',
      });
      setReason('');
    } catch (error) {
      toast({
        title: 'Error',
        description: 'Failed to submit adoption request.',
        variant: 'destructive',
      });
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <Card>
      <CardHeader>
        <CardTitle className="flex items-center gap-2">
          <Crown className="h-5 w-5" />
          Request Adoption
        </CardTitle>
        <CardDescription>
          Submit a request to become the maintainer of this idea
        </CardDescription>
      </CardHeader>
      <CardContent>
        <form onSubmit={handleSubmit} className="space-y-4">
          <div>
            <label htmlFor="reason" className="block text-sm font-medium text-gray-700 mb-2">
              Reason for Adoption
            </label>
            <textarea
              id="reason"
              value={reason}
              onChange={(e) => setReason(e.target.value)}
              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500"
              rows={4}
              placeholder="Explain why you want to adopt this idea and your plans for it..."
              required
            />
          </div>
          <Button type="submit" loading={isSubmitting} loadingText="Submitting..." className="w-full">
            Submit Adoption Request
          </Button>
        </form>
      </CardContent>
    </Card>
  );
};

// License Information Component
const LicenseInfo = ({ license }: { license?: string }) => {
  if (!license) return null;

  const licenseConfig = {
    'MIT': {
      name: 'MIT License',
      description: 'A permissive license with minimal restrictions',
      url: 'https://opensource.org/licenses/MIT'
    },
    'Apache-2.0': {
      name: 'Apache License 2.0',
      description: 'A permissive license with patent protection',
      url: 'https://opensource.org/licenses/Apache-2.0'
    },
    'GPL-3.0': {
      name: 'GNU General Public License v3.0',
      description: 'A copyleft license requiring derivative works to be open source',
      url: 'https://opensource.org/licenses/GPL-3.0'
    },
    'CC-BY-4.0': {
      name: 'Creative Commons Attribution 4.0',
      description: 'Allows others to distribute and build upon the material',
      url: 'https://creativecommons.org/licenses/by/4.0/'
    }
  };

  const config = licenseConfig[license as keyof typeof licenseConfig] || {
    name: license,
    description: 'Custom license',
    url: null
  };

  return (
    <Card>
      <CardHeader>
        <CardTitle className="flex items-center gap-2">
          <FileCheck className="h-5 w-5" />
          License
        </CardTitle>
      </CardHeader>
      <CardContent>
        <div className="space-y-2">
          <div className="flex items-center justify-between">
            <span className="font-medium">{config.name}</span>
            {config.url && (
              <Button variant="ghost" size="sm" asChild>
                <a href={config.url} target="_blank" rel="noopener noreferrer">
                  <ExternalLink className="h-4 w-4" />
                </a>
              </Button>
            )}
          </div>
          <p className="text-sm text-gray-600">{config.description}</p>
        </div>
      </CardContent>
    </Card>
  );
};

export default function IdeaDetailPage() {
  const params = useParams();
  const ideaId = params.id as string;
  const { user } = useAuth();
  
  // Hooks
  const { data: idea, isLoading, error } = useIdea(ideaId);
  const upvoteMutation = useUpvoteIdea();

  const handleUpvote = () => {
    if (!idea?._id) return;
    upvoteMutation.mutate(idea._id);
  };

  if (isLoading) {
    return (
      <div className="container mx-auto px-4 py-8">
        <div className="animate-pulse space-y-6">
          <div className="h-8 w-32 bg-gray-200 rounded"></div>
          <div className="bg-white rounded-lg border p-6 space-y-4">
            <div className="h-8 w-3/4 bg-gray-200 rounded"></div>
            <div className="h-4 w-1/2 bg-gray-200 rounded"></div>
            <div className="h-20 w-full bg-gray-200 rounded"></div>
          </div>
        </div>
      </div>
    );
  }

  if (error || !idea) {
    return (
      <div className="container mx-auto px-4 py-8">
        <div className="text-center py-12">
          <h1 className="text-2xl font-bold text-gray-900 mb-4">Idea Not Found</h1>
          <p className="text-gray-600 mb-4">
            The idea you're looking for doesn't exist or has been removed.
          </p>
          <Link href="/ideas" className="btn-primary px-4 py-2 rounded-md">
            Back to Ideas
          </Link>
        </div>
      </div>
    );
  }

  // Determine if user can manage ownership
  const canManageOwnership = user && (
    user._id === idea.originalCreator ||
    user._id === idea.currentMaintainer ||
    (idea.ownershipType === OwnershipType.COLLABORATIVE)
  );

  // Determine if user can request adoption
  const canRequestAdoption = user && 
    user._id !== idea.currentMaintainer &&
    idea.adoptionStatus === AdoptionStatus.AVAILABLE;

  return (
    <div className="container mx-auto px-4 py-8">
      {/* Navigation */}
      <nav className="mb-6">
        <Link href="/ideas" className="text-primary-600 hover:text-primary-700 text-sm font-medium">
          ← Back to Ideas
        </Link>
      </nav>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {/* Main Content */}
        <div className="lg:col-span-2 space-y-8">
          {/* Idea Header */}
          <Card>
            <CardContent className="p-6">
              <div className="space-y-4">
                {/* Title and Ownership */}
                <div className="flex items-start justify-between">
                  <div className="flex-1">
                    <h1 className="text-3xl font-bold text-gray-900 mb-3">{idea.title}</h1>
                    <div className="flex items-center gap-3 mb-4">
                      <OwnershipBadge ownershipType={idea.ownershipType} />
                      {idea.adoptionStatus && idea.adoptionStatus !== AdoptionStatus.ADOPTED && (
                        <AdoptionStatusBadge status={idea.adoptionStatus} />
                      )}
                      {idea.license && (
                        <Badge variant="outline" className="flex items-center gap-1">
                          <FileCheck className="h-3 w-3" />
                          {idea.license}
                        </Badge>
                      )}
                    </div>
                  </div>
                </div>

                {/* Creator and Maintainer Info */}
                <div className="flex items-center space-x-6 text-sm text-gray-600">
                  <div className="flex items-center space-x-2">
                    <User className="h-4 w-4" />
                    <span>Created by</span>
                    <Link
                      href={`/users/${idea.author?.username}`}
                      className="text-primary-600 hover:text-primary-700 font-medium"
                    >
                      {idea.author?.username || 'Anonymous'}
                    </Link>
                  </div>
                  
                  {idea.currentMaintainer && idea.currentMaintainer !== idea.originalCreator && (
                    <div className="flex items-center space-x-2">
                      <Crown className="h-4 w-4" />
                      <span>Maintained by</span>
                      <Link
                        href={`/users/${idea.currentMaintainer}`}
                        className="text-primary-600 hover:text-primary-700 font-medium"
                      >
                        {idea.currentMaintainer}
                      </Link>
                    </div>
                  )}

                  <div className="flex items-center space-x-2">
                    <Calendar className="h-4 w-4" />
                    <span>{new Date(idea.createdAt || '').toLocaleDateString()}</span>
                  </div>

                  {idea.parentId && (
                    <Badge variant="outline" className="text-purple-600 border-purple-200">
                      <GitFork className="h-3 w-3 mr-1" />
                      Forked
                    </Badge>
                  )}
                </div>

                {/* Tags and Domain */}
                <div className="flex flex-wrap gap-2">
                  {idea.domain?.map((d: string) => (
                    <Badge key={d} variant="secondary" className="bg-blue-100 text-blue-800">
                      {d}
                    </Badge>
                  ))}
                  {idea.tags?.map((tag: string) => (
                    <Badge key={tag} variant="outline">
                      #{tag}
                    </Badge>
                  ))}
                </div>

                {/* Description Preview */}
                <div className="prose max-w-none">
                  <p className="text-gray-700 whitespace-pre-wrap leading-relaxed">
                    {idea.description.length > 200
                      ? `${idea.description.substring(0, 200)}...`
                      : idea.description}
                  </p>
                  {idea.description.length > 200 && (
                    <p className="text-primary-600 text-sm font-medium mt-2">
                      View full description in Overview tab
                    </p>
                  )}
                </div>

                {/* Stats */}
                <div className="flex items-center space-x-6 pt-4 border-t border-gray-200">
                  <div className="flex items-center space-x-2">
                    <Star className="w-5 h-5 text-gray-400" />
                    <span className="text-gray-600">{idea.upvotes || 0} upvotes</span>
                  </div>
                  <div className="flex items-center space-x-2">
                    <GitFork className="w-5 h-5 text-gray-400" />
                    <span className="text-gray-600">{idea.forkCount || 0} forks</span>
                  </div>
                  <div className="flex items-center space-x-2">
                    <MessageSquare className="w-5 h-5 text-gray-400" />
                    <span className="text-gray-600">Comments</span>
                  </div>
                  <div className="flex items-center space-x-2">
                    <Eye className="w-5 h-5 text-gray-400" />
                    <span className="text-gray-600">{idea.viewCount || 0} views</span>
                  </div>
                </div>

                {/* Adoption Alert */}
                {idea.adoptionStatus === AdoptionStatus.AVAILABLE && (
                  <Alert className="border-green-200 bg-green-50">
                    <Crown className="h-4 w-4 text-green-600" />
                    <AlertDescription className="text-green-800">
                      This idea is available for adoption. Interested in becoming the maintainer?
                    </AlertDescription>
                  </Alert>
                )}

                {idea.adoptionStatus === AdoptionStatus.IN_DISPUTE && (
                  <Alert className="border-yellow-200 bg-yellow-50">
                    <Vote className="h-4 w-4 text-yellow-600" />
                    <AlertDescription className="text-yellow-800">
                      This idea's ownership is currently under community review due to competing adoption requests.
                    </AlertDescription>
                  </Alert>
                )}
              </div>
            </CardContent>
          </Card>

          {/* Main Tabs */}
          <Tabs defaultValue="overview" className="bg-white rounded-lg border">
            <TabsList className="grid w-full grid-cols-5 rounded-none border-b bg-transparent p-0">
              <TabsTrigger
                value="overview"
                className="flex items-center space-x-2 rounded-none border-b-2 border-transparent data-[state=active]:border-primary data-[state=active]:bg-transparent"
              >
                <FileText className="h-4 w-4" />
                <span>Overview</span>
              </TabsTrigger>
              <TabsTrigger
                value="repository"
                className="flex items-center space-x-2 rounded-none border-b-2 border-transparent data-[state=active]:border-primary data-[state=active]:bg-transparent"
              >
                <FolderOpen className="h-4 w-4" />
                <span>Repository</span>
              </TabsTrigger>
              <TabsTrigger
                value="discussions"
                className="flex items-center space-x-2 rounded-none border-b-2 border-transparent data-[state=active]:border-primary data-[state=active]:bg-transparent"
              >
                <MessageSquare className="h-4 w-4" />
                <span>Discussions</span>
              </TabsTrigger>
              <TabsTrigger
                value="tree"
                className="flex items-center space-x-2 rounded-none border-b-2 border-transparent data-[state=active]:border-primary data-[state=active]:bg-transparent"
              >
                <GitBranch className="h-4 w-4" />
                <span>Family Tree</span>
              </TabsTrigger>
              <TabsTrigger
                value="ownership"
                className="flex items-center space-x-2 rounded-none border-b-2 border-transparent data-[state=active]:border-primary data-[state=active]:bg-transparent"
              >
                <Crown className="h-4 w-4" />
                <span>Ownership</span>
              </TabsTrigger>
            </TabsList>

            <TabsContent value="overview" className="p-6 mt-0">
              <div className="prose max-w-none">
                <h3 className="text-lg font-semibold text-gray-900 mb-4">About This Idea</h3>
                <p className="text-gray-700 whitespace-pre-wrap leading-relaxed">
                  {idea.description}
                </p>

                {/* Ownership Details */}
                <div className="mt-8 space-y-6">
                  <h4 className="text-md font-semibold text-gray-900">Ownership Information</h4>
                  
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <Card>
                      <CardHeader className="pb-3">
                        <CardTitle className="text-sm font-medium text-gray-700">Ownership Type</CardTitle>
                      </CardHeader>
                      <CardContent>
                        <OwnershipBadge ownershipType={idea.ownershipType} />
                        <p className="text-sm text-gray-600 mt-2">
                          {idea.ownershipType === OwnershipType.PERSONAL && "This idea is owned and controlled by an individual."}
                          {idea.ownershipType === OwnershipType.OPEN_SOURCE && "This idea is open for community contributions."}
                          {idea.ownershipType === OwnershipType.COLLABORATIVE && "This idea is managed by multiple collaborators."}
                          {idea.ownershipType === OwnershipType.ORGANIZATION && "This idea is owned by an organization."}
                          {idea.ownershipType === OwnershipType.STEWARDSHIP && "This idea is maintained by a steward for the community."}
                        </p>
                      </CardContent>
                    </Card>

                    <Card>
                      <CardHeader className="pb-3">
                        <CardTitle className="text-sm font-medium text-gray-700">Current Status</CardTitle>
                      </CardHeader>
                      <CardContent>
                        {idea.adoptionStatus && idea.adoptionStatus !== AdoptionStatus.ADOPTED ? (
                          <AdoptionStatusBadge status={idea.adoptionStatus} />
                        ) : (
                          <Badge variant="outline" className="bg-gray-100 text-gray-800">
                            Active Development
                          </Badge>
                        )}
                        <p className="text-sm text-gray-600 mt-2">
                          {idea.adoptionStatus === AdoptionStatus.AVAILABLE && "Available for community adoption."}
                          {idea.adoptionStatus === AdoptionStatus.PENDING && "Adoption request under review."}
                          {idea.adoptionStatus === AdoptionStatus.IN_DISPUTE && "Multiple adoption requests require community voting."}
                          {(!idea.adoptionStatus || idea.adoptionStatus === AdoptionStatus.ADOPTED) && "Actively maintained by current owner."}
                        </p>
                      </CardContent>
                    </Card>
                  </div>
                </div>
              </div>
            </TabsContent>

            <TabsContent value="repository" className="p-6 mt-0">
              <FileSystemTab ideaId={ideaId} />
            </TabsContent>

            <TabsContent value="discussions" className="p-6 mt-0">
              <CommentList ideaId={ideaId} />
            </TabsContent>

            <TabsContent value="tree" className="p-6 mt-0">
              <div className="space-y-4">
                <FamilyTreePreview ideaId={ideaId} />
                <div className="text-center">
                  <Link
                    href={`/ideas/${ideaId}/tree`}
                    className="inline-flex items-center px-4 py-2 text-sm font-medium text-primary-600 hover:text-primary-700 border border-primary-200 rounded-md hover:bg-primary-50"
                  >
                    View Full Tree →
                  </Link>
                </div>
              </div>
            </TabsContent>

            <TabsContent value="ownership" className="p-6 mt-0">
              <div className="space-y-6">
                <div>
                  <h3 className="text-lg font-semibold text-gray-900 mb-4">Ownership Management</h3>
                  <p className="text-gray-600 mb-6">
                    Manage ownership, adoption requests, and collaboration settings for this idea.
                  </p>
                </div>

                {/* Ownership History */}
                <Card>
                  <CardHeader>
                    <CardTitle className="flex items-center gap-2">
                      <Clock className="h-5 w-5" />
                      Ownership History
                    </CardTitle>
                  </CardHeader>
                  <CardContent>
                    <div className="space-y-3">
                      <div className="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg">
                        <User className="h-5 w-5 text-gray-400" />
                        <div className="flex-1">
                          <p className="text-sm font-medium">
                            Created by {idea.author?.username}
                          </p>
                          <p className="text-xs text-gray-500">
                            {new Date(idea.createdAt || '').toLocaleDateString()}
                          </p>
                        </div>
                        <Badge variant="outline">Original Creator</Badge>
                      </div>
                      
                      {idea.adoptionHistory && idea.adoptionHistory.length > 0 && (
                        idea.adoptionHistory.map((adoption, index) => (
                          <div key={index} className="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg">
                            <Crown className="h-5 w-5 text-gray-400" />
                            <div className="flex-1">
                              <p className="text-sm font-medium">
                                Adopted by {adoption.newMaintainer}
                              </p>
                              <p className="text-xs text-gray-500">
                                {new Date(adoption.adoptedAt).toLocaleDateString()}
                              </p>
                            </div>
                            <Badge variant="outline">Maintainer</Badge>
                          </div>
                        ))
                      )}
                    </div>
                  </CardContent>
                </Card>

                {/* Adoption Request Form */}
                {canRequestAdoption && (
                  <AdoptionRequestForm ideaId={ideaId} currentUser={user} />
                )}

                {/* Management Controls */}
                {canManageOwnership && (
                  <Card>
                    <CardHeader>
                      <CardTitle className="flex items-center gap-2">
                        <Settings className="h-5 w-5" />
                        Management Controls
                      </CardTitle>
                      <CardDescription>
                        Manage ownership settings and transfer options
                      </CardDescription>
                    </CardHeader>
                    <CardContent>
                      <div className="space-y-4">
                        <Button variant="outline" className="w-full justify-start">
                          <Users className="h-4 w-4 mr-2" />
                          Change Ownership Type
                        </Button>
                        <Button variant="outline" className="w-full justify-start">
                          <Crown className="h-4 w-4 mr-2" />
                          Transfer Ownership
                        </Button>
                        <Button variant="outline" className="w-full justify-start">
                          <Shield className="h-4 w-4 mr-2" />
                          Update License
                        </Button>
                        {idea.ownershipType === OwnershipType.COLLABORATIVE && (
                          <Button variant="outline" className="w-full justify-start">
                            <Users className="h-4 w-4 mr-2" />
                            Manage Collaborators
                          </Button>
                        )}
                      </div>
                    </CardContent>
                  </Card>
                )}

                {/* Current Adoption Requests */}
                {idea.adoptionStatus === AdoptionStatus.PENDING && (
                  <Card>
                    <CardHeader>
                      <CardTitle className="flex items-center gap-2">
                        <Clock className="h-5 w-5" />
                        Pending Adoption Requests
                      </CardTitle>
                    </CardHeader>
                    <CardContent>
                      <Alert>
                        <AlertDescription>
                          There are adoption requests pending review. If you are the current maintainer, 
                          you can review and respond to these requests.
                        </AlertDescription>
                      </Alert>
                    </CardContent>
                  </Card>
                )}

                {/* Voting Interface */}
                {idea.adoptionStatus === AdoptionStatus.IN_DISPUTE && (
                  <Card>
                    <CardHeader>
                      <CardTitle className="flex items-center gap-2">
                        <Vote className="h-5 w-5" />
                        Community Voting
                      </CardTitle>
                      <CardDescription>
                        Multiple adoption requests require community input
                      </CardDescription>
                    </CardHeader>
                    <CardContent>
                      <Alert className="mb-4">
                        <AlertDescription>
                          This idea has competing adoption requests. The community will vote to determine 
                          the new maintainer. Voting is open for 7 days.
                        </AlertDescription>
                      </Alert>
                      <div className="space-y-3">
                        {/* TODO: Render actual voting candidates */}
                        <div className="p-3 border rounded-lg">
                          <div className="flex items-center justify-between">
                            <div>
                              <p className="font-medium">Candidate 1</p>
                              <p className="text-sm text-gray-600">Reason for adoption...</p>
                            </div>
                            <Button size="sm">Vote</Button>
                          </div>
                        </div>
                      </div>
                    </CardContent>
                  </Card>
                )}
              </div>
            </TabsContent>
          </Tabs>
        </div>

        {/* Sidebar */}
        <div className="space-y-6">
          {/* Action Buttons */}
          <Card>
            <CardHeader>
              <CardTitle>Actions</CardTitle>
            </CardHeader>
            <CardContent className="space-y-3">
              {user && user._id !== idea.authorId && (
                <>
                  <Link
                    href={`/ideas/${ideaId}/fork`}
                    className="w-full btn-primary px-4 py-2 rounded-md block text-center"
                  >
                    <GitFork className="h-4 w-4 mr-2 inline" />
                    Fork This Idea
                  </Link>
                  <Button
                    onClick={handleUpvote}
                    disabled={upvoteMutation.isPending}
                    variant={idea.hasUpvoted ? "default" : "outline"}
                    className="w-full"
                  >
                    <Star className={`h-4 w-4 mr-2 ${idea.hasUpvoted ? 'fill-current' : ''}`} />
                    {upvoteMutation.isPending
                      ? 'Processing...'
                      : `${idea.hasUpvoted ? 'Upvoted' : 'Upvote'} (${idea.upvotes || 0})`}
                  </Button>
                </>
              )}
              {user && user._id === idea.authorId && (
                <Link
                  href={`/ideas/${ideaId}/edit`}
                  className="w-full btn-secondary px-4 py-2 rounded-md block text-center"
                >
                  <Settings className="h-4 w-4 mr-2 inline" />
                  Edit Idea
                </Link>
              )}
              <Button variant="outline" className="w-full">
                <Copy className="h-4 w-4 mr-2" />
                Share Idea
              </Button>
            </CardContent>
          </Card>

          {/* License Information */}
          {idea.license && <LicenseInfo license={idea.license} />}

          {/* Family Tree Preview */}
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <GitBranch className="h-5 w-5" />
                Idea Family Tree
              </CardTitle>
            </CardHeader>
            <CardContent>
              <FamilyTreePreview ideaId={ideaId} />
              <div className="mt-4">
                <Link
                  href={`/ideas/${ideaId}/tree`}
                  className="text-primary-600 hover:text-primary-700 text-sm font-medium"
                >
                  View Full Tree →
                </Link>
              </div>
            </CardContent>
          </Card>

          {/* Creator/Maintainer Info */}
          <Card>
            <CardHeader>
              <CardTitle>About the Team</CardTitle>
            </CardHeader>
            <CardContent className="space-y-4">
              {/* Original Creator */}
              {idea.author && (
                <div>
                  <div className="flex items-center gap-2 mb-2">
                    <User className="h-4 w-4 text-gray-500" />
                    <span className="text-sm font-medium text-gray-700">Original Creator</span>
                  </div>
                  <div className="ml-6">
                    <Link
                      href={`/users/${idea.author.username}`}
                      className="text-primary-600 hover:text-primary-700 font-medium"
                    >
                      @{idea.author.username}
                    </Link>
                    <div className="text-sm text-gray-500">
                      <span className="font-medium">Karma:</span> {idea.author.karma || 0}
                    </div>
                  </div>
                </div>
              )}

              {/* Current Maintainer */}
              {idea.currentMaintainer && idea.currentMaintainer !== idea.originalCreator && (
                <div>
                  <div className="flex items-center gap-2 mb-2">
                    <Crown className="h-4 w-4 text-gray-500" />
                    <span className="text-sm font-medium text-gray-700">Current Maintainer</span>
                  </div>
                  <div className="ml-6">
                    <Link
                      href={`/users/${idea.currentMaintainer}`}
                      className="text-primary-600 hover:text-primary-700 font-medium"
                    >
                      @{idea.currentMaintainer}
                    </Link>
                  </div>
                </div>
              )}

              {/* Adoption Status */}
              {canRequestAdoption && (
                <div className="pt-3 border-t">
                  <Badge variant="outline" className="bg-green-50 text-green-700 border-green-200">
                    Available for Adoption
                  </Badge>
                  <p className="text-xs text-gray-600 mt-1">
                    This idea is looking for a new maintainer
                  </p>
                </div>
              )}
            </CardContent>
          </Card>
        </div>
      </div>
    </div>
  );
}